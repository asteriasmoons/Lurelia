                            }
                            .overlay {
                                Circle()
                                    .strokeBorder(LColors.glassBorder.opacity(0.75), lineWidth: 1)
                            }
                            .shadow(color: Color.clear, radius: 8, y: 4)

                        LureliaReportTextField(
                            title: "",
                            placeholder: "Step \(index + 1)",
                            text: $steps[index],
                            borderColor: accentColor
                        )

                        if steps.count > 1 {
                            Button {
                                steps.remove(at: index)
